# --- Local development ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_ENGINE=sqlite
DATABASE_NAME=db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Railway production (set in Railway dashboard, not in committed files) ---
# SECRET_KEY=generate-a-long-random-value
# DEBUG=false
# SECURE_SSL_REDIRECT=true
# DATA_DIR=/data
# ALLOWED_HOSTS=your-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# RAILWAY_PUBLIC_DOMAIN is usually injected automatically by Railway after you generate a public domain.

# Optional PostgreSQL configuration (not used for the temporary SQLite demo)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Optional one-time superuser creation via Railway shell (never commit real values):
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=use-a-strong-temporary-password
